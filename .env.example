# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public address of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.deepsemantic.ru

# Keep "false" until the real content is ready; "true" lets search engines index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# PostgreSQL connection string (Neon / Supabase give you one). Needed only for db:* commands
# and, from Phase 1 on, for the running app.
DATABASE_URL=postgres://user:password@localhost:5432/deepsemantic

# --- Contact form (Phase 1) ---
# Where messages from the contact form are delivered.
CONTACT_TO_EMAIL=mikhailzolotov4444@gmail.com
# Sender address; the domain must be verified in Resend (https://resend.com).
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
# Cloudflare Turnstile (free spam protection): secret key and public site key.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# "true" = form works without Resend/Turnstile: messages are printed to the server log instead
# of emailed. For local development and tests ONLY; never switch on in production.
CONTACT_DEV_MODE=false
